# ==============================================================================
# GACHA BUILDER REST API - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env lalu sesuaikan dengan connection string database Anda.
# ==============================================================================

# Supabase PostgreSQL Connection String
# Opsi 1 (Supabase Transaction Pooler):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Opsi 2 (Supabase Direct Connection):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Port Server Lokal Flask
PORT=5000

# Mode Lingkungan (development / production)
FLASK_ENV=development
FLASK_DEBUG=True
